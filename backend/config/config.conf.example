# home-backup-indicator config
#
# Copy this file to $XDG_CONFIG_HOME/home-backup-indicator/config.conf
# (usually ~/.config/home-backup-indicator/config.conf) and edit as needed.
# It's sourced by home-backup.sh as plain bash, so anything defined here
# overrides the script's built-in defaults.

# Name of the rclone remote created via `rclone config` (rclone listremotes
# will show it as "onedrive:" if you named it "onedrive").
#RCLONE_REMOTE="onedrive"

# Subfolder on the remote under which everything is backed up. Defaults to
# "<OS name>Backup" (e.g. "FedoraBackup"), derived from /etc/os-release, so
# each machine/distro gets its own folder on the remote.
#REMOTE_BASE="HomeBackup"

# Every non-hidden top-level folder in $HOME is synced automatically (so a
# newly created folder is picked up on the next run with no config changes),
# except the ones listed here. Uncomment and edit to change the skip list.
#SKIP_TOPLEVEL_DIRS=(Downloads Desktop Music Pictures Videos Public Templates)

# Hidden ($HOME/.foo) folders to sync explicitly — dotfolders are never
# auto-discovered, since most (.cache, .config, .mozilla, ...) shouldn't be
# backed up wholesale. Map of local path -> subfolder on the remote.
#declare -A EXTRA_HIDDEN_PATHS=(
#  ["$HOME/.ssh"]="ssh"
#)

# To fully opt out of auto-discovery and go back to an explicit folder list,
# set this instead (it replaces the auto-discovered set entirely; the
# EXTRA_HIDDEN_PATHS above are still merged in on top of it):
#declare -A SYNC_PATHS_OVERRIDE=(
#  ["$HOME/Documents"]="Documents"
#  ["$HOME/Project"]="Project"
#)

# Individual dotfiles synced as a set into ${REMOTE_BASE}/dotfiles.
#DOTFILES=(
#  "$HOME/.bashrc"
#  "$HOME/.gitconfig"
#)

# rclone exclude patterns applied to every entry in SYNC_PATHS (not to DOTFILES).
#EXCLUDES=(
#  --exclude "node_modules/**"
#  --exclude ".venv/**"
#  --exclude "venv/**"
#  --exclude "__pycache__/**"
#  --exclude "*.pyc"
#  --exclude "dist/**"
#  --exclude "build/**"
#  --exclude "target/**"
#  --exclude ".cache/**"
#  --exclude ".terraform/**"
#)
